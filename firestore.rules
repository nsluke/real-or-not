rules_version = '2';

// One vote per anonymous user per post. The document id is pinned to
// "<postId>__<uid>", so a user physically cannot hold two votes on one post, and the
// tallies the site shows are aggregation counts over these docs — there is no counter
// document a client could write a made-up number into.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwnVote(voteId) {
      return request.auth != null
          && request.resource.data.uid == request.auth.uid
          && voteId == request.resource.data.postId + '__' + request.auth.uid;
    }

    function isWellFormed() {
      let d = request.resource.data;
      return d.keys().hasOnly(['postId', 'uid', 'verdict', 'reason', 'at'])
          && d.keys().hasAll(['postId', 'uid', 'verdict', 'at'])
          && d.postId is string
          && d.postId.size() > 0 && d.postId.size() <= 16
          && d.postId.matches('^[a-z0-9]+$')
          && d.verdict in ['real', 'fake', 'unsure']
          && (d.reason == null || (d.verdict == 'unsure' && d.reason in ['blurry', 'more', 'closer']))
          && d.at == request.time;
    }

    match /votes/{voteId} {
      // Public: the site counts votes for everyone, including people who haven't voted yet.
      allow read: if true;

      allow create, update: if isOwnVote(voteId) && isWellFormed();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
